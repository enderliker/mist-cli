# Configuración de Mistral AI
# Opción 1: API Key general de Mistral Studio (La Plateforme)
MISTRAL_API_KEY=tu_mistral_api_key_aqui

# Opción 2: API Key exclusiva de Codestral (https://codestral.mistral.ai)
# Si defines CODESTRAL_API_KEY en lugar de MISTRAL_API_KEY, el CLI apuntará automáticamente al endpoint de Codestral
# CODESTRAL_API_KEY=tu_codestral_api_key_aqui

# Overrides opcionales
# MISTRAL_MODEL=codestral-latest
# MISTRAL_BASE_URL=https://api.mistral.ai
