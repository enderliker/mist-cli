# Mistral AI Authentication
# Option 1: General Mistral API Key (https://console.mistral.ai)
MISTRAL_API_KEY=your_mistral_api_key_here

# Option 2: Dedicated Codestral API Key (https://codestral.mistral.ai)
# If CODESTRAL_API_KEY is set instead of MISTRAL_API_KEY, the CLI points automatically to Codestral endpoint.
# CODESTRAL_API_KEY=your_codestral_api_key_here

# Optional overrides
# MISTRAL_MODEL=codestral-latest
# MISTRAL_BASE_URL=https://api.mistral.ai

# Tavily Web Search API (Optional: enables live web_search tool)
# TAVILY_API_KEY=tvly-your_tavily_api_key_here
